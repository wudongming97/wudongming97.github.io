source "https://rubygems.org"

# Keep this aligned with GitHub Pages' dependency set.
# Extra / unsupported plugins (e.g. hawkins) will fail remote builds with:
# "The github-pages gem can't satisfy your Gemfile's dependencies."
gem "github-pages", group: :jekyll_plugins

# Needed for `bundle exec jekyll serve` on Ruby 3+.
gem "webrick", "~> 1.8"
